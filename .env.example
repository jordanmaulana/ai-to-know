# --- Django ---
# These values are for host dev (`make dev` on :8000, Vite on :5173). The compose stack
# publishes the backend on host :8012 and the SPA on host :3012 — a different origin — so
# .env.docker needs DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3012 (it feeds both
# CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS) and SITE_URL=http://localhost:8012 when the
# containers are hit directly rather than through a reverse proxy.
SECRET_KEY=
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database ---
# Leave POSTGRES_HOST empty for SQLite (host dev). Compose: POSTGRES_HOST=postgres.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=

# --- Syllabus crawler (Hacker News -> OpenAI judge) ---
# Without a key the crawler still prefilters and records candidates, but judges nothing.
OPENAI_API_KEY=
SYLLABUS_CRAWLER_MODEL=gpt-5

# --- Mayar (payments) ---
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
MAYAR_BASE_URL=https://api.mayar.id/hl/v1
PAYMENT_REDIRECT_URL=http://localhost:5173/

# --- URLs ---
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Frontend build args ---
# Read by vite at BUILD time and inlined into the bundle, so a change means a rebuild.
# In .env.docker set VITE_API_URL=http://localhost:8012 — the URL the browser calls, not
# http://backend:8000, which only resolves inside the compose network.
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
