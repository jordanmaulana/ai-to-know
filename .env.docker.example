# Copy to .env.docker and fill in. Consumed by docker-compose.yml, `make dock`,
# `make backup`, `make crawl-docker` and ./update.sh — all of them pass --env-file .env.docker.
#
# Two origins: the tunnel sends the site hostname to 127.0.0.1:3012 (nginx, SPA only) and
# the api hostname to 127.0.0.1:8012 (Django: /api/v1/, the CMS at /dashboard/, /admin/).

# --- Django ---
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-base64-48
DEBUG=False
# The api hostname, plus localhost,127.0.0.1 — those two are REQUIRED, not cosmetic. The
# backend healthcheck curls 127.0.0.1:8000; drop them and Django answers 400 DisallowedHost,
# backend stays `unhealthy` forever, and `frontend` (depends_on: service_healthy) never
# leaves `Created`.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
# Feeds CORS_ALLOWED_ORIGINS *and* CSRF_TRUSTED_ORIGINS. The site origin is for the SPA's
# fetches; the api origin is for CMS / admin login POSTs ("Origin checking failed" without it).
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://api.example.com

# Container wall clock for the `cron` service (docker/crontab). Keep it equal to
# DJANGO_TIME_ZONE, or the daily crawl fires at a different hour than the crontab reads.
TZ=Asia/Jakarta

# --- Database ---
# Compose sets POSTGRES_HOST=postgres itself.
POSTGRES_DB=aitoknow
POSTGRES_USER=aitoknow
# Read ONLY by initdb, on the first boot with an empty data dir. Change it later — or
# boot once before this file is filled in — and the cluster keeps the OLD credentials
# while the backend sends the new ones: crash-loop on `password authentication failed`.
# `down` (and so `make dock` / update.sh) keeps the volume, so redeploying never fixes
# it. Recover with `ALTER ROLE <user> WITH PASSWORD ...` (keeps data) or `down -v`
# (wipes the database). Note 127.0.0.1 is `trust` in pg_hba, so testing from inside the
# postgres container succeeds even while the backend fails — test over `-h postgres`.
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_PORT=5432

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=

# --- Syllabus crawler (Hacker News -> OpenAI judge) ---
# Without a key the crawler still prefilters and records candidates, but judges nothing.
OPENAI_API_KEY=
SYLLABUS_CRAWLER_MODEL=gpt-5

# --- URLs ---
SITE_URL=https://api.example.com
FRONTEND_URL=https://example.com

# --- Frontend build args (baked in at build time: change => `docker compose build frontend`) ---
# The URL the *browser* calls — the public api origin, never http://backend:8000.
VITE_API_URL=https://api.example.com
VITE_GOOGLE_CLIENT_ID=
