# --- tailwind stage: build static/output.css ---
FROM node:20-alpine AS tw
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY static ./static
COPY templates ./templates
RUN npx @tailwindcss/cli -i ./static/input.css -o ./static/output.css --minify

# --- python stage ---
FROM python:3.12-slim AS app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    HOME=/home/app \
    PATH="/app/.venv/bin:$PATH"
# PATH puts the venv first so `gunicorn` / `python manage.py ...` work directly.
# `uv run` revalidates the lock on every invocation — build-time only, not runtime.
# No build-essential: every dep ships a manylinux wheel for py3.12 (psycopg[binary]
# bundles libpq) and bson's sdist is pure Python. If a future dep needs a compiler,
# `uv sync` below fails loudly — add it back then.
# tzdata: the image is UTC but settings.TIME_ZONE is Asia/Jakarta — without it the `TZ`
# env the cron service sets is ignored and the crontab fires 7h off.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpq5 curl ca-certificates tzdata && \
    rm -rf /var/lib/apt/lists/*

# supercronic — cron for the `cron` compose service (ROLE=cron). Vanilla cron scrubs the
# environment, so the job would lose OPENAI_API_KEY/POSTGRES_* from env_file and silently
# degrade to a prefilter-only crawl. supercronic inherits the env and logs to stdout.
ARG TARGETARCH
ARG SUPERCRONIC_VERSION=v0.2.49
RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64) sha1=e63c11a9726b775a6a11801e81af4f3fb926aa68 ;; \
      arm64) sha1=0b6c5bb743e0b0dafed1132198c81807927ac413 ;; \
      *) echo "supercronic: unsupported arch '$arch'" >&2; exit 1 ;; \
    esac; \
    curl -fsSLo /usr/local/bin/supercronic \
      "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-${arch}"; \
    echo "${sha1}  /usr/local/bin/supercronic" | sha1sum -c -; \
    chmod +x /usr/local/bin/supercronic

COPY --chmod=755 docker/backend-entrypoint.sh /entrypoint.sh
# Non-root. Everything under /app is created already owned by `app`, via --chown
# below: a `chown -R app /app` after the fact rewrites the whole venv into an extra layer.
RUN useradd --create-home --uid 10001 app && mkdir -p /app && chown app:app /app
WORKDIR /app
USER app
COPY --chown=app:app pyproject.toml uv.lock ./
# uv is mounted for this one command rather than COPYed into the image: it is a
# build-time tool only (the venv is on PATH at runtime).
RUN --mount=from=ghcr.io/astral-sh/uv:latest,source=/uv,target=/usr/local/bin/uv \
    uv sync --frozen --no-install-project
COPY --chown=app:app . .
COPY --from=tw --chown=app:app /app/static/output.css ./static/output.css
# The entrypoint collectstatics into staticfiles/, so /app stays writable by `app`.
RUN rm -f static/input.css
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "core.wsgi", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--worker-class", "gthread", \
     "--threads", "4", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100", \
     "--timeout", "60", \
     "--access-logfile", "-"]
